FROM node:22-bookworm-slim

ARG CLAUDE_CODE_VERSION=2.1.220

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 python3-venv tini \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force

RUN ln -s /usr/bin/python3 /usr/local/bin/python
RUN python3 -m venv /opt/claude-agent-sdk \
    && /opt/claude-agent-sdk/bin/pip install --no-cache-dir "claude-agent-sdk==0.2.135"
COPY ops/worker_exec.py /usr/local/bin/oca-worker-exec
COPY src/app/runtime/agent_sdk_runner.py /usr/local/bin/oca-agent-sdk-runner
RUN chmod 755 /usr/local/bin/oca-worker-exec /usr/local/bin/oca-agent-sdk-runner

# The upstream Node image's `node` user is uid/gid 1000.  It matches the demo
# host user while still ensuring the worker never runs as root.
WORKDIR /workspace
RUN chown node:node /workspace
USER node

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
