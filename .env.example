# WebAgent v0.3.0 — unofficial, trusted-local demo defaults.
# The Web/session/file/log routes have no user authentication. Listening is
# controlled by uvicorn --host/--port; keep it on loopback unless a real
# authentication proxy protects every route.
API_KEY=demo-local-key

RUNTIME_BACKEND=fake
DATABASE_URL=sqlite:///./data/demo.db
SANDBOX_BACKEND=docker
WORKSPACE_ROOT=./data/workspaces
DOCKER_IMAGE=webagent-worker:latest
DOCKER_NETWORK_MODE=none
DOCKER_CPUS=1.0
DOCKER_MEMORY=512m
DOCKER_PIDS_LIMIT=128
SESSION_PAUSE_AFTER_SECONDS=1800
SESSION_DELETE_AFTER_SECONDS=7200
SESSION_REAPER_INTERVAL_SECONDS=30
SESSION_DELETE_WORKSPACE=true

FAKE_STREAM_DELAY_MS=80
FAKE_LONG_TASK_DELAY_MS=500

# Optional legacy structured-plan runtime. FakeRuntime remains the no-provider default.
ZHIPU_API_KEY=
ZHIPU_MODEL=
ZHIPU_BASE_URL=

# Real Web UI tasks require RUNTIME_BACKEND=claude, Docker, and a network mode
# that can reach the chosen Provider. Endpoint/key/auth are supplied by the
# browser per turn; CLAUDE_* below are optional deployment defaults for curl.
# The SDK runs inside the worker and does not read host login/subscription state.
# claude-cli is an explicit fallback. Compatible gateways may require
# ANTHROPIC_AUTH_TOKEN instead of ANTHROPIC_API_KEY.
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=
CLAUDE_AVAILABLE_MODELS=
MODEL_CATALOG_CACHE_SECONDS=300
CLAUDE_AUTH_ENV=ANTHROPIC_API_KEY
CLAUDE_SDK_RUNNER=/usr/local/bin/oca-agent-sdk-runner
CLAUDE_COMMAND=claude
CLAUDE_TIMEOUT_SECONDS=600
